{
  "name": "assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @assistant/db generate",
    "db:migrate": "pnpm --filter @assistant/db migrate",
    "seed": "pnpm --filter @assistant/db seed",
    "auth:bot": "tsx scripts/auth-bot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "dotenv": "^16.6.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
