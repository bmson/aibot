# ── Database ────────────────────────────────────────────────────────────────
# Local: docker compose db service. Prod: Neon connection string (Secret Manager).
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant

# ── Models (OpenRouter is the single gateway) ───────────────────────────────
# https://openrouter.ai/settings/keys — set a spend limit on the key itself.
OPENROUTER_API_KEY=

# ── Owner ───────────────────────────────────────────────────────────────────
OWNER_EMAIL=bmson@bmson.com
OWNER_PHONE=

# ── Web auth (Auth.js) ──────────────────────────────────────────────────────
# Google OAuth client for signing in to the web UI (allowlisted to OWNER_EMAIL).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Owner auth is fail-closed when OAuth is absent. Set true only for local dev.
AUTH_DEV_BYPASS=true

# ── Bot Google identity (assistant@…) — Phase 3 ─────────────────────────────
# OAuth client (Internal consent screen) + refresh token from scripts/auth-bot.ts
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BOT_GOOGLE_REFRESH_TOKEN=

# ── Twilio — Phase 4 ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Drivers: local dev vs GCP ───────────────────────────────────────────────
# local = in-process queue poller / fake-gcs; cloudtasks|gcs = real GCP services
QUEUE_DRIVER=local
FILES_DRIVER=local
# fake-gcs-server endpoint for FILES_DRIVER=local
GCS_ENDPOINT=http://localhost:4443
WORKSPACE_BUCKET=assistant-workspace

# ── Public URL (webhooks) ───────────────────────────────────────────────────
# Local: cloudflared tunnel URL from scripts/dev-tunnel.sh. Prod: Cloud Run URL.
PUBLIC_URL=http://localhost:8787

# ── Workspace browser — Phase 6 ─────────────────────────────────────────────
# Profile-tarball encryption: 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
PROFILE_ENC_KEY=
# local = detached child process (needs `pnpm --filter @assistant/browser-job exec playwright install chromium`)
# cloudrun = Cloud Run Job execution (prod; set by deploy.sh)
BROWSER_DRIVER=local
BROWSER_JOB_NAME=assistant-browser
# Trace-archive bucket (30-day lifecycle). Empty = traces land in the workspace store.
TRACES_BUCKET=

# ── Real integration canaries ───────────────────────────────────────────────
# Explicit opt-in: each run self-sends/deletes one Gmail message, sends one SMS
# to OWNER_PHONE, launches one browser job, denies a synthetic approval, and
# streams one tiny model reply. The structural ceiling is checked before launch.
CANARY_ENABLED=false
CANARY_MAX_COST_USD=0.03

# ── OpenTelemetry ───────────────────────────────────────────────────────────
# local: console exporter; set OTEL_EXPORTER_OTLP_ENDPOINT for a collector
OTEL_SERVICE_NAME=assistant
OTEL_EXPORTER=console

# ── Service ports ───────────────────────────────────────────────────────────
WEB_PORT=3000
AGENT_PORT=8787
# Local-only internal callback authentication. Production deploys with OIDC.
INTERNAL_AUTH_MODE=shared-secret
# Needed only when calling /internal/* locally: openssl rand -hex 32
INTERNAL_API_SECRET=
