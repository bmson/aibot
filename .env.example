# ── Database ────────────────────────────────────────────────────────────────
# Local: docker compose db service. Prod: Neon connection string (Secret Manager).
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant

# ── Models (OpenRouter is the single gateway) ───────────────────────────────
# https://openrouter.ai/settings/keys — set a spend limit on the key itself.
OPENROUTER_API_KEY=

# ── Owner ───────────────────────────────────────────────────────────────────
OWNER_EMAIL=bmson@bmson.com
OWNER_PHONE=

# ── Web auth (Auth.js) ──────────────────────────────────────────────────────
# Google OAuth client for signing in to the web UI (allowlisted to OWNER_EMAIL).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Bot Google identity (assistant@…) — Phase 3 ─────────────────────────────
# OAuth client (Internal consent screen) + refresh token from scripts/auth-bot.ts
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BOT_GOOGLE_REFRESH_TOKEN=

# ── Twilio — Phase 4 ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Drivers: local dev vs GCP ───────────────────────────────────────────────
# local = in-process queue poller / fake-gcs; cloudtasks|gcs = real GCP services
QUEUE_DRIVER=local
FILES_DRIVER=local
# fake-gcs-server endpoint for FILES_DRIVER=local
GCS_ENDPOINT=http://localhost:4443
WORKSPACE_BUCKET=assistant-workspace

# ── Public URL (webhooks) ───────────────────────────────────────────────────
# Local: cloudflared tunnel URL from scripts/dev-tunnel.sh. Prod: Cloud Run URL.
PUBLIC_URL=http://localhost:8787

# ── Workspace encryption (browser profile tarballs) — Phase 6 ───────────────
# 32-byte key, base64. Generate: openssl rand -base64 32
PROFILE_ENC_KEY=

# ── OpenTelemetry ───────────────────────────────────────────────────────────
# local: console exporter; set OTEL_EXPORTER_OTLP_ENDPOINT for a collector
OTEL_SERVICE_NAME=assistant
OTEL_EXPORTER=console

# ── Service ports ───────────────────────────────────────────────────────────
WEB_PORT=3000
AGENT_PORT=8787
# Shared secret for web→agent internal API calls (local dev). Prod uses OIDC.
INTERNAL_API_SECRET=dev-internal-secret
