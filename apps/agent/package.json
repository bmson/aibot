{
  "name": "@assistant/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.mjs --external:unpdf --sourcemap --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant/config": "workspace:*",
    "@assistant/core": "workspace:*",
    "@assistant/db": "workspace:*",
    "@assistant/modules": "workspace:*",
    "@assistant/tools": "workspace:*",
    "@hono/node-server": "^2.0.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "ai": "^7.0.29",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "jose": "^6.2.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.23.1"
  }
}
