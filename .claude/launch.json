{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@assistant/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-qa",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTH_GOOGLE_ID=",
        "AUTH_DEV_BYPASS=true",
        "pnpm",
        "--filter",
        "@assistant/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
